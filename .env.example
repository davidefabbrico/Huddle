# Copy to .env.local and fill in (Supabase dashboard -> Project Settings -> API Keys).
# .env.local is git-ignored. Use only the public "publishable" key, never the secret/service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
